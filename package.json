{
  "name": "tato-ju-ai-short-drama",
  "version": "0.1.0",
  "description": "开源 AI 短剧创作工作台：剧本、资源、分镜与视频生成",
  "author": "Tato-Ju",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "selftest": "node scripts/verify.cjs selftest",
    "smoke": "node scripts/verify.cjs smoke",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "ofetch": "^1.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pinia": "^2.3.1",
    "sharp": "^0.35.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.1.10"
  }
}
